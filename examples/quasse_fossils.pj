# Run the complete model with pjcli --runs 2 (or set Executions in Settings).
birth := quasse_constant(rate=1.5)
death := quasse_constant(rate=0.5)
fossil := quasse_constant(rate=0.5)
mixed ~ iid(2, quasse(birth_rate=birth, death_rate=death, fossil_rate=fossil, stop='age', stop_value=4, diffusion=0.5, sampling_prob=0.5, cond_surv='false', method='local_thinning', block_duration=0.5, max_nodes=10000))
fossil_only ~ iid(2, quasse(birth_rate=birth, death_rate=death, fossil_rate=fossil, stop='age', stop_value=4, diffusion=0.5, sampling_prob=0, cond_surv='false', method='local_thinning', block_duration=0.5, max_nodes=10000))
sampled_size ~ iid(2, quasse(birth_rate=birth, death_rate=death, fossil_rate=fossil, stop='size', stop_value=15, diffusion=0.5, sampling_prob=0.5, method='local_thinning', block_duration=0.5, max_nodes=10000))
