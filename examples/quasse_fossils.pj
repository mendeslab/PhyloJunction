birth := quasse_constant(rate=.5)
death := quasse_constant(rate=.2)
fossil := quasse_constant(rate=1)
mixed ~ quasse(n=2,nr=2,birth_rate=birth,death_rate=death,fossil_rate=fossil,stop="age",stop_value=2,diffusion=.5,sampling_prob=.5,cond_surv="false",method="local_thinning",block_duration=.5,max_nodes=10000)
fossil_only ~ quasse(n=2,nr=2,birth_rate=birth,death_rate=death,fossil_rate=fossil,stop="age",stop_value=2,diffusion=.5,sampling_prob=0,cond_surv="false",method="local_thinning",block_duration=.5,max_nodes=10000)
sampled_size ~ quasse(n=2,nr=2,birth_rate=birth,death_rate=death,fossil_rate=fossil,stop="size",stop_value=5,diffusion=.5,sampling_prob=.5,method="local_thinning",block_duration=.5,max_nodes=10000)
