# Run the complete model with pjcli --runs 2 (or set Executions in Settings).
# number of replicate trees per simulation
n_rep <- 2

# Two fixed-rate scenarios, each containing two IID trees per execution.
birth_rates <- [0.8, 0.9]
birth_rate <- birth_rates[1]

# alternatively, stochastic-node variable ('birth_rate') assignment
# (comment out previous command)
# birth_rate ~ exponential(rate=1.0)

# deterministic-node variable ('det_birth_rate') assignment
det_birth_rate := sse_rate(name="lambda", value=birth_rate, event="speciation")

# alternatively, deterministic node can also be specified as:
# (comment out previous command)
# det_birth_rate := sse_rate(name="lambda", value=birth_rate, states=[0,0,0], event="w_speciation")

# deterministic-node variable ('sse_stash') assignment
stash := sse_stash(flat_rate_mat=[det_birth_rate])

# stochastic-node variable ('trs') assignment
ori <- 2.0
trs ~ iid(n_rep, discrete_sse(stash=stash, start_state=0, stop='age', stop_value=ori, origin='true'))

det_birth_rate2 := sse_rate(name="lambda2", value=birth_rates[2], event="speciation")
stash2 := sse_stash(flat_rate_mat=[det_birth_rate2])
trs2 ~ iid(n_rep, discrete_sse(stash=stash2, start_state=0, stop="age", stop_value=ori, origin="true"))
