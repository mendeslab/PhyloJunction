# A GeoSSE tree with every supplied stochastic history retained as a mapped tree.
trs <- read_tree(file_path="examples/trees_maps_files/geosse_dummy_tree2.tre", node_name_attr="index")
histories := read_maps(file_path="examples/trees_maps_files/geosse_dummy_tree2_maps.tsv", tip_attr_file_path="examples/trees_maps_files/geosse_dummy_tree2_tip_states.tsv", n_regions=2, geo=true)
mapped_trs := map_attr(tree=trs[1], history=histories, attr_name="state")
# Clock draws preserve the discrete maps; each mapped tree receives its own rate vector.
n_rec_br := n_rec_branches(mapped_trs)
br_specific_rel_rate ~ [iid(n, lognormal(-0.125, 0.5)) for n in n_rec_br]
phylo ~ [gamma_spike_clock(t, "mutation_rate", 0.001, 0.01, 2.0, r) for (t, r) in zip_strict(mapped_trs, br_specific_rel_rate)]
